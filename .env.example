NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
# Defina true somente se a API estiver atrás de um proxy/load balancer confiável
TRUST_PROXY=false

DATABASE_URL=postgres://aurora:aurora@localhost:5432/aurora
DB_POOL_MAX=10

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=aurora-api
JWT_AUDIENCE=aurora-mobile
REFRESH_TOKEN_TTL_DAYS=30

# Apps mobile nativos não usam CORS; liste origens apenas se houver cliente web
CORS_ORIGINS=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Login social (opcional). Google: IDs de cliente (Android/iOS/Web) separados por vírgula.
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
AUTH_RATE_LIMIT_MAX=10

# Busca de destinos e lugares (Google Places API New). Sem chave as rotas /places respondem 503.
GOOGLE_PLACES_API_KEY=
PLACES_RATE_LIMIT_MAX=30
