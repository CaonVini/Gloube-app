NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
# Defina true somente se a API estiver atrás de um proxy/load balancer confiável
TRUST_PROXY=false

DATABASE_URL=postgres://aurora:aurora@localhost:5432/aurora
DB_POOL_MAX=10

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=aurora-api
JWT_AUDIENCE=aurora-mobile
REFRESH_TOKEN_TTL_DAYS=30

# Apps mobile nativos não usam CORS; liste origens apenas se houver cliente web
CORS_ORIGINS=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Login social (opcional). Google: IDs de cliente (Android/iOS/Web) separados por vírgula.
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
AUTH_RATE_LIMIT_MAX=10

# Swagger em /docs (padrão: ligado fora de produção, desligado em produção)
DOCS_ENABLED=

# IA do roteiro (opcional). Segredos SÓ aqui/no ambiente, nunca no repositório.
# Sem OPENAI_API_KEY + OPENAI_MODEL a rota de IA responde 503. Não há modelo padrão: escolha um bom e não o mais caro.
OPENAI_API_KEY=
# Sugestão: gpt-4.1-mini (bom custo-benefício, bem abaixo dos modelos topo de linha). Confira o preço atual antes de preencher.
OPENAI_MODEL=gpt-4.1-mini
# Preço em USD por 1 milhão de tokens do modelo escolhido (para estimar o custo). Sem preço o custo fica nulo.
AI_PRICE_INPUT_PER_1M_USD=
AI_PRICE_OUTPUT_PER_1M_USD=
AI_PROMPT_VERSION=v1
AI_DAILY_LIMIT_PER_USER=5
AI_RATE_LIMIT_MAX=5

# Limite por minuto POR USUÁRIO autenticado (além do limite por IP)
USER_RATE_LIMIT_MAX=120
